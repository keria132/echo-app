{
  "name": "echo-app-root",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint:frontend": "npm --prefix frontend run lint:fix",
    "lint:backend": "npm --prefix backend run lint:fix",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "type-check:frontend": "npm --prefix frontend run type-check",
    "type-check:backend": "npm --prefix backend run type-check",
    "type-check": "npm run type-check:frontend && npm run type-check:backend",
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend && npm run build --prefix backend",
    "start": "npm run start --prefix backend"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "npm --prefix frontend run lint"
    ],
    "backend/**/*.{ts}": [
      "npm --prefix backend run lint"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
